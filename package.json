{
  "name": "naranxia-dev",
  "private": true,
  "description": "Naranxia game, web and desktop workspace",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "workspaces": [
    "packages/*",
    "apps/desktop"
  ],
  "scripts": {
    "build": "node tools/build.mjs",
    "build:release": "npm run build && node tools/build_dist.mjs",
    "package:desktop": "npm run build:release && npm run build --workspace @naranxia/desktop --",
    "dev": "vite --host 127.0.0.1 --config tools/vite.config.mjs",
    "test": "npm run build:release && node tools/test_all.mjs",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{js,mjs,cjs}\"",
    "format:check": "prettier --check \"**/*.{js,mjs,cjs}\"",
    "test:architecture": "node --test tests/architecture-check.test.mjs",
    "check:architecture": "node tools/check-architecture.mjs",
    "quality": "npm run test:architecture && npm run check:architecture && npm run lint && npm run format:check"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@fontsource/cinzel": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "@fontsource/marcellus": "5.3.0",
    "@gfx/zopfli": "1.0.15",
    "esbuild": "0.24.2",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "lottie-web": "5.13.0",
    "prettier": "3.10.0",
    "terser": "5.31.0",
    "three": "0.128.0",
    "vite": "5.4.14"
  }
}
